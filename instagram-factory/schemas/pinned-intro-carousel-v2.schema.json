{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandersmoley.github.io/-/schemas/pinned-intro-carousel-v2.schema.json",
  "title": "Pinned intro carousel v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "platform",
    "format",
    "status",
    "publish",
    "canvas",
    "safeZone",
    "contentSource",
    "captionSha256",
    "designTokens",
    "layoutFamily",
    "selectedCover",
    "asset",
    "caption",
    "coverVariants",
    "slides"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "const": "pinned-intro-carousel-v2" },
    "platform": { "const": "instagram" },
    "format": { "const": "carousel-3x4" },
    "status": { "const": "approved-for-render" },
    "publish": { "const": false },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1440 }
      }
    },
    "safeZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "const": 120 },
        "right": { "const": 120 },
        "bottom": { "const": 120 },
        "left": { "const": 120 }
      }
    },
    "contentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "freezeHeading"],
      "properties": {
        "path": { "const": "content/pinned-intro-carousel-v2.md" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "freezeHeading": { "const": "# 15. Final copy freeze" }
      }
    },
    "captionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "designTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ink", "paper", "blue", "grid"],
      "properties": {
        "ink": { "const": "#101010" },
        "paper": { "const": "#f4f1e9" },
        "blue": { "const": "#1546e8" },
        "grid": { "const": "rgba(21, 70, 232, 0.105)" }
      }
    },
    "layoutFamily": { "const": "pinned-intro-editorial" },
    "selectedCover": { "const": "cover-b" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "sha256", "source", "width", "height", "treatment"],
      "properties": {
        "id": { "const": "MAHTX_B6J9k" },
        "name": { "const": "alexsmoley-photo-chair" },
        "path": { "const": "assets/photos/alexsmoley-photo-chair-thumb.jpg" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "const": "Canva approved asset thumbnail" },
        "width": { "const": 150 },
        "height": { "const": 200 },
        "treatment": { "const": "intentional low-resolution editorial raster; no generative redraw" }
      }
    },
    "caption": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverVariants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/item" }
    },
    "slides": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "headlineIndexes",
        "text",
        "visualType",
        "usesApprovedPhoto",
        "expectedArrowCount",
        "visualCoreCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(cover-[abc]|slide-0[1-9])$" },
        "mode": {
          "enum": [
            "cover-photo",
            "cover-mission",
            "cover-human-system",
            "skills-collage",
            "evidence-wall",
            "reveal",
            "factory-map",
            "approval-contrast",
            "quality-contrast",
            "route-map",
            "closing"
          ]
        },
        "headlineIndexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 20 }
        },
        "text": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        },
        "visualType": {
          "enum": ["photo", "photo-diagram", "collage", "evidence", "diagram", "contrast", "process", "photo-process"]
        },
        "usesApprovedPhoto": { "type": "boolean" },
        "expectedArrowCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "visualCoreCount": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    }
  }
}
