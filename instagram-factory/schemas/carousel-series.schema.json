{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexandersmoley.github.io/-/schemas/carousel-series.schema.json",
  "title": "Alex Smoley structured Instagram carousel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "platform",
    "format",
    "status",
    "publish",
    "canvas",
    "safeZone",
    "contentSource",
    "captionSha256",
    "designTokens",
    "layoutFamily",
    "caption",
    "slides"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "automation-day-carousel"
    },
    "platform": {
      "const": "instagram"
    },
    "format": {
      "const": "carousel-3x4"
    },
    "status": {
      "enum": [
        "draft",
        "approved-for-render",
        "rendered"
      ]
    },
    "publish": {
      "const": false
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1440
        }
      }
    },
    "safeZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "const": 120
        },
        "right": {
          "const": 120
        },
        "bottom": {
          "const": 120
        },
        "left": {
          "const": 120
        }
      }
    },
    "contentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "content/automation-day-carousel.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "captionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "designTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink",
        "paper",
        "blue",
        "grid"
      ],
      "properties": {
        "ink": {
          "const": "#101010"
        },
        "paper": {
          "const": "#f4f1e9"
        },
        "blue": {
          "const": "#1546e8"
        },
        "grid": {
          "const": "rgba(21, 70, 232, 0.105)"
        }
      }
    },
    "layoutFamily": {
      "const": "process-diagram-carousel"
    },
    "caption": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/slide"
      },
      "description": "Число слайдов задаёт содержание, а не рендерер. Бриф и структурированный файл обязаны совпадать по количеству — это проверяет гейт slideCountExact."
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "headlineIndexes",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^slide-(0[1-9]|1[0-2])$"
        },
        "mode": {
          "enum": [
            "statement",
            "pipeline",
            "breakpoint",
            "criteria-list",
            "closing"
          ]
        },
        "headlineIndexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          }
        },
        "text": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "copyLayout": {
          "description": "Как плоский массив text группируется в абзацы утверждённого markdown-блока. Каждая запись — [сколько строк взять, чем склеить]; склейка указывается явно. null вместо числа означает «все оставшиеся строки». Без copyLayout каждая строка становится отдельным абзацем.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        "expectedSequence": {
          "description": "Точная последовательность строк, которую слайд обязан содержать: гейт declaredSequencesExact сверяет её со срезом text по expectedSequenceRange. Порядок объявляется данными, а не зашит в код по id слайда.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedSequenceRange": {
          "description": "Полуинтервал [from, to) в массиве text, к которому относится expectedSequence. По умолчанию — весь массив.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "dependentRequired": {
        "expectedSequenceRange": [
          "expectedSequence"
        ]
      }
    }
  }
}
