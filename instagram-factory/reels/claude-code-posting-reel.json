  "scenes": [
    {
      "id": "scene-01",
      "start": 0,
      "end": 4,
      "goal": "hook and the whole loop in one line",
      "layoutFamily": "reel-kinetic-statement",
      "text": [
        "Я перестал выкладывать посты руками",
        "Идея → публикация → аналитика",
        "Четыре сервиса, один процесс"
      ]
    },
    {
      "id": "scene-02",
      "start": 4,
      "end": 8,
      "goal": "idea lives in Todoist",
      "layoutFamily": "reel-process-minimal",
      "text": [
        "Идея лежит в Todoist",
        "тема → фактура → срок",
        "Оттуда её забирает Claude Code"
      ]
    },
    {
      "id": "scene-03",
      "start": 8,
      "end": 12.5,
      "goal": "GitHub holds the brief and freezes the copy",
      "layoutFamily": "reel-process-build",
      "text": [
        "Материал собирается в GitHub",
        "бриф → copy freeze → контрольные суммы",
        "Текст заморожен: рендер не имеет права его менять"
      ]
    },
    {
      "id": "scene-04",
      "start": 12.5,
      "end": 17,
      "goal": "Claude Code builds and gates on QA",
      "layoutFamily": "reel-contrast-statement",
      "text": [
        "Дальше работает Claude Code",
        "сборка → рендер → QA",
        "Красный прогон — публикации нет"
      ]
    },
    {
      "id": "scene-05",
      "start": 17,
      "end": 21,
      "goal": "Metricool publishes, the human approves",
      "layoutFamily": "reel-system-diagram",
      "text": [
        "Публикует Metricool",
        "Todoist → GitHub → Claude Code → Metricool → Instagram",
        "Моё участие — одно «ок»"
      ]
    },
    {
      "id": "scene-06",
      "start": 21,
      "end": 25,
      "goal": "analytics closes the loop, call to subscribe",
      "layoutFamily": "reel-closing-editorial",
      "text": [
        "Аналитика возвращается в план",
        "и цикл идёт заново",
        "Подписывайтесь — показываю, что ломается и как чиню"
      ]
    }
  ],
  "cover": {
    "layoutFamily": "reel-cover-editorial",
    "text": [
      "Посты выкладываю не я",
      "Todoist → GitHub → Claude Code → Metricool"
    ]
